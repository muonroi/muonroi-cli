+namespace TCIS.CodeStandards.Tests;
+
+using System.Collections.Immutable;
+using System.IO;
+using Microsoft.CodeAnalysis;
+using Microsoft.CodeAnalysis.CSharp;
+using Microsoft.CodeAnalysis.Diagnostics;
+using Xunit;
+
+/// <summary>
+/// TCIS0001 — No source line may exceed 150 characters.
+/// </summary>
+public class TCIS0001_MaxLineLengthAnalyzerTests
+{
+    private static ImmutableArray<Diagnostic> GetDiagnostics(string source)
+    {
+        CSharpParseOptions parseOptions = CSharpParseOptions.Default
+            .WithLanguageVersion(LanguageVersion.Latest);
+        CSharpCompilation compilation = CSharpCompilation.Create(
+            "TestAssembly",
+            new[] { CSharpSyntaxTree.ParseText(source, parseOptions) },
+            GetReferences(),
+            new CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary));
+
+        ImmutableArray<DiagnosticAnalyzer> analyzers =
+            ImmutableArray.Create<DiagnosticAnalyzer>(new TCIS.CodeStandards.Analyzers.TCIS0001_MaxLineLengthAnalyzer());
+        return compilation.WithAnalyzers(analyzers)
+            .GetAnalyzerDiagnosticsAsync().GetAwaiter().GetResult();
+    }
+
+    private static List<MetadataReference> GetReferences()
+    {
+        string tpa = (string)AppContext.GetData("TRUSTED_PLATFORM_ASSEMBLIES")!;
+        return tpa
+            .Split(Path.PathSeparator)
+            .Where(p => p.Length > 0)
+            .Select(p => (MetadataReference)MetadataReference.CreateFromFile(p))
+            .ToList();
+    }
+
+    [Fact]
+    public void TCIS0001_LineUnder150_ShouldNotWarn()
+    {
+        string line = new string('x', 149);
+        string source = $$"""
+namespace TCIS.MyApp
+{
+    public class MyService
+    {
+        public void Run() { var x = "{{line}}"; }
+    }
+}
+""";
+        Assert.DoesNotContain(GetDiagnostics(source), d => d.Id == "TCIS0001");
+    }
+
+    [Fact]
+    public void TCIS0001_LineExactly150_ShouldNotWarn()
+    {
+        string line = new string('x', 150);
+        string source = $$"""
+namespace TCIS.MyApp
+{
+    public class MyService
+    {
+        public void Run() { var x = "{{line}}"; }
+    }
+}
+""";
+        Assert.DoesNotContain(GetDiagnostics(source), d => d.Id == "TCIS0001");
+    }
+
+    [Fact]
+    public void TCIS0001_LineExceeds150_ShouldWarn()
+    {
+        string line = new string('x', 151);
+        string source = $$"""
+namespace TCIS.MyApp
+{
+    public class MyService
+    {
+        public void Run() { var x = "{{line}}"; }
+    }
+}
+""";
+        Assert.Contains(GetDiagnostics(source), d => d.Id == "TCIS0001");
+    }
+
+    [Fact]
+    public void TCIS0001_VeryLongLine_ShouldWarn()
+    {
+        string sql = new string('S', 300);
+        string source = $$"""
+using TCIS.MyApp;
+
+namespace TCIS.MyApp
+{
+    public class MyService
+    {
+        public string GetSql() { return "{{sql}}"; }
+    }
+}
+""";
+        Assert.Contains(GetDiagnostics(source), d => d.Id == "TCIS0001");
+    }
+
+    [Fact]
+    public void TCIS0001_NonTCISNamespace_ShouldNotWarn()
+    {
+        string line = new string('x', 200);
+        string source = $$"""
+namespace MyApp.Services
+{
+    public class MyService
+    {
+        public void Run() { var x = "{{line}}"; }
+    }
+}
+""";
+        Assert.DoesNotContain(GetDiagnostics(source), d => d.Id == "TCIS0001");
+    }
+}
